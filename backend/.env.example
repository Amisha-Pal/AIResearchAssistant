# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=research_assistant
POSTGRES_USER=research_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2
# Run tasks inline without a worker (useful for quick local debugging only).
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- API rate limits (DRF throttle syntax: <n>/<sec|min|hour|day>) ---
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=600/min
API_THROTTLE_AUTH=10/min
# Number of trusted reverse proxies (0 = ignore X-Forwarded-For, use the socket address)
API_NUM_PROXIES=0

# --- Uploads ---
MAX_PDF_UPLOAD_MB=25

# --- Local AI (Ollama, no paid APIs) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_FALLBACK_MODELS=qwen2.5:1.5b
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=5m
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
# auto | cpu | cuda  (auto picks CUDA when PyTorch can see a GPU, otherwise CPU)
COMPUTE_DEVICE=auto
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
